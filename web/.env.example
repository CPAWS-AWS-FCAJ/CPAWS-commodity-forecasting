# Sao chép thành .env.local (không commit). Chỉ đặt giá trị công khai ở đây:
# mọi thứ bí mật nằm sau API, front-end không giữ khóa nào.

# Để trống VITE_API_URL (hoặc VITE_USE_SAMPLE=true) để chạy bằng dữ liệu mẫu.
VITE_API_URL=
VITE_USE_SAMPLE=true

# Hiển thị giá vàng/bạc (nguồn Yahoo, ADR-0005). Mặc định tắt (phương án dự phòng đang áp dụng):
# vàng/bạc chỉ hiện % thay đổi và xác suất tăng. Chỉ bật khi ghi rõ true.
VITE_SHOW_METAL_PRICES=false

# Chế độ mẫu: fixture độ tin cậy (not_ready | collecting | ready), mặc định collecting.
VITE_SAMPLE_ACCURACY=collecting

# Bật đăng nhập Cognito khi Tuấn đã tạo User Pool.
VITE_AUTH_ENABLED=false
VITE_REGION=ap-southeast-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
