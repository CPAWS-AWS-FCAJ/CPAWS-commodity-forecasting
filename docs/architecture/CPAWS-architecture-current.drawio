5F5F5;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1585" y="280" width="150" height="80" as="geometry"/></mxCell><mxCell id="c77" value="cdk deploy&lt;br&gt;docker push&lt;br&gt;(from laptop)" style="text;html=1;whiteSpace=wrap;fontSize=9;fontColor=#545B64;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1582" y="372" width="90" height="45" as="geometry"/></mxCell><mxCell id="c78" value="18" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1561" y="300" width="22" height="22" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;CPAWS — current architecture (as of 2026-11-08)&lt;/b&gt;. Solid = deployed and running; faded icon + dashed arrow = in progress (PR #87, #89), not deployed yet.&lt;br&gt;&lt;b&gt;Flows:&lt;/b&gt; 1 schedule ingest · 2 fetch prices · 3 write raw/clean snapshot · 4 trigger predict on ingest success or failure (predict skips assets missing the latest session, PredictFailed → alarm) · 5 read snapshot, write S1a shadow · 6 write forecast (no overwrite) · 7–9 scheduled accuracy job (Tue–Sat, 20:45 VN; schedule disabled) · 10 open web · 11 sign in · 12 call API with ID token · 13 read forecasts · 14 chat quota · 15 Bedrock Converse with tools get_forecast / get_news · 16 accuracy API · 17 alarms to email · 18 deploy from laptop.&lt;br&gt;&lt;b&gt;Changed vs. proposal:&lt;/b&gt; no Step Functions / SageMaker training and Model Registry (ADR-0011, champion baseline-q252 with S1a in shadow); no Bedrock batch labeling or Knowledge Bases (ADR-0013, manual news labels); Secrets Manager → SSM Parameter Store; GitHub Actions is CI only (no CD); Bedrock Guardrail not attached yet." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="1078" width="1365" height="70" as="geometry"/></mxCell><mxCell id="c81" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="966" y="552" width="22" height="22" as="geometry"/></mxCell><mxCell id="e82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.1;entryX=1;entryY=0.85;" edge="1" parent="1" source="c40" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="656"/><mxPoint x="1015" y="513"/></Array></mxGeometry></mxCell><mxCell id="e83" value="GetItem / Query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c39" target="c24"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="933"/><mxPoint x="740" y="600"/><mxPoint x="1155" y="600"/><mxPoint x="1155" y="493"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
